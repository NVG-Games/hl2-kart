# Godot cache
.godot/

# Valve content: extracted on each player's machine by tools/setup_assets.py.
# Never commit it.
/assets/

# Local files
/screenshots/
/server.cfg
# a dedicated server's custom tracks (6.8): the folder ships empty
/tracks/*
!/tracks/.gdignore
!/tracks/README.txt
/export_presets.cfg
/builds/
__pycache__/
*.pyc
*.log

# release builds
/dist/
/.cache/
