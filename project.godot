; Engine configuration file.
config_version=5

[application]

config/name="Half-Life 2: Kart"
config/description="Kart racer built from Half-Life 2 assets"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/core/game.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}

[physics]

3d/default_gravity=15.24
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
