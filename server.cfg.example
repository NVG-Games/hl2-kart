// Half-Life 2: Kart dedicated server config.
// Copy to server.cfg (next to the game executable, or into the project folder)
// and start the server with:
//   godot --headless --path . -- --dedicated
// Command-line flags override this file:
//   --name "My server" --port 27015 --max 8 --bots on --grid 8 --laps 3
//   --track xen --difficulty normal --hazards on --password secret
//   --lan --master master.example.net:27010 --config path/to/server.cfg
//   --tracks path/to/tracks --tracklist "canal_run, xen, city17_circuit"

hostname "City 17 Grand Prix"
port 27015          // UDP game port; browsers query port+1 (27016)
maxplayers 8        // people allowed on the server (1-8)
bot_fill 1          // 1 = bots fill empty grid slots, 0 = people only
bot_grid 8          // field size the bots fill up to (2-8)
mp_laps 3
mp_track city17_circuit   // or ct17, black_mesa, xen, surface_tension, nova_prospekt, white_forest, or a custom track's file name from the tracks folder
mp_difficulty normal   // easy / normal / hard
mp_hazards 1           // 1 = track hazards (turrets, trains, strikes...), 0 = off
sv_password ""      // empty = anyone can join
sv_lan 0            // 1 = do not register with the master server
sv_master ""        // master server address (host[:27010]) for the INTERNET tab
sv_upnp 0           // 1 = ask the router to forward the ports (home servers)

// Custom tracks (.hl2kt files from the TRACK EDITOR). The server looks in sv_tracks first, then
// in the tracks folder next to the executable, then in its own user://tracks folder.
sv_tracks ""        // an extra folder of .hl2kt files (searched first)
sv_downloads 1      // 1 = players without the track download it in the lobby, 0 = they are turned away
sv_download_rate 192   // KB/s for all downloads while a race runs (the lobby goes as fast as it can)
mp_tracklist ""     // tracks to rotate through, comma-separated: "canal_run, xen, Old Docks, c_1a2b3c4d5e6f7a8b"
                    // (without an mp_track line the server starts on the list's first track)
mp_rotate 1         // with a track list: 1 = the next track after every race, 0 = stay on mp_track

// Console commands while it runs: status, say <text>, kick <nick>, start (skips READY,
// never the track), lobby, tracks, rescan (reads the track folders again: files added or
// replaced while it runs), track <name>, next, set <cvar> <value>, rules, help, quit
